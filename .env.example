# ── warehouseHelper: переменные окружения ────────────────────
# Шаблон для локального файла .env (в git не коммитится).
#
# ЕДИНЫЙ ФОРМАТ: КЛЮЧ=значение, БЕЗ кавычек.
# Если значение содержит пробелы или символ "#", его можно
# обернуть в двойные кавычки — godotenv снимет их при загрузке.
#
# Значения в этом файле — только примеры-заглушки.
# Реальные значения хранятся в локальном .env.

# ── Приложение ──────────────────────────────────────────────
# Адрес HTTP-сервера (формат net/http Addr)
APP_HTTPADDRESS=:8080
# Время жизни файлов в temp/ (часы); по умолчанию 24
APP_TEMPCLEANUP_MAXAGE_HOURS=24

# ── Честный знак ─────────────────────────────────────────────
# Корневая папка фото кодов маркировки (по умолчанию ../QRCodes — от cmd/).
QR_PHOTOS_DIR=../QRCodes
# Срок жизни фото (часы); всё старше удаляется при открытии «Получить коды».
# По умолчанию 168 (неделя).
QR_PHOTOS_MAXAGE_HOURS=168

# ── МойСклад: учётные записи ────────────────────────────────
# Список ключей через запятую, формат: <API-ключ>-<имя>
MSAPI_KEYS_WAREHOUSE=token1-Склад1,token2-Склад2
MSAPI_KEYS_OTHERS=token3-Прочее
# Рейт-лимит: интервал (сек) и максимум запросов за интервал
MSAPI_REQUESTCAPTIMESPAN=5
MSAPI_REQUESTCAP=10
# Идентификаторы сущностей МойСклад
MSAPI_SELLTYPEID=
MSAPI_REFGONUMBERID=
MSAPI_COURIERID=
MSAPI_TIMEFORMAT=2006-01-02 15:04:05
MSAPI_URLSTART=https://api.moysklad.ru/api/remap/1.2/entity/
# Заголовок авторизации: Basic base64(логин:пароль)
MSAPI_AUTHHEADER=
MSAPI_ENCODEHEADER=utf-8

# ── МойСклад: id сущностей (href'ы собираются из MSAPI_URLSTART + путь + id) ──
MSAPI_READYSTATE_ID=
MSAPI_SHIPEDSTATE_ID=
MSAPI_SELLTYPEOTHER_ID=
# Тип кастом-сущности «Вид продажи» (сегмент пути customentity/{тип}/{id})
MSAPI_SELLTYPEOTHER_TYPE=
MSAPI_ORG_ID=
MSAPI_REFGOCOURIER_ID=
MSAPI_PRINTTEMPLATE_ID=

# ── RefGo ───────────────────────────────────────────────────
# Последний обработанный номер заказа (целое число, без кавычек).
# Значение обновляется приложением автоматически.
RG_LATESTORDER=0
# Модуль сверки с перевозчиком. Цены зон — рубли за один тариф,
# лимит веса — килограммы, комиссии за приём оплаты — проценты.
# Если хотя бы одна переменная не задана или невалидна,
# модуль сверки отключается (кнопка «Провести сверку» недоступна).
RG_GREENZONE_PRICE=500
RG_YELLOWZONE_PRICE=700
RG_ORANGEZONE_PRICE=900
RG_REDZONE_PRICE=1200
RG_BLUEZONE_PRICE=1500
RG_WEIGHTLIMIT=20
RG_CASHTAX=5
RG_CARDTAX=5

# ── PostgreSQL ──────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=changeme
PG_DATABASE=warehouse

# ── Telegram ────────────────────────────────────────────────
# Бот для уведомлений (создаётся в @BotFather), токен — секрет.
# chat_id группы склада (для групп — отрицательный, напр. -1001234567890).
# Если токен или chat_id склада не заданы — уведомления отключены.
TG_BOT_TOKEN=
TG_WAREHOUSE_CHAT_ID=
TG_EVERYONE_CHAT_ID=
